# Text model: Xiaomi MiMo, OpenAI-compatible Chat Completions API.
MODEL_PROVIDER_TEXT=mimo
MODEL_PROVIDER_TEXT_MODEL=mimo-v2.5-pro
MIMO_API_KEY=replace-me
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TEXT_MODEL=mimo-v2.5-pro

# Optional context and recovery controls.
MODEL_CONTEXT_WINDOW_TOKENS=131072
MODEL_SUMMARY_MAX_OUTPUT_TOKENS=4096
CONTEXT_COMPACT_BUFFER_TOKENS=13000
CONTEXT_WARNING_BUFFER_TOKENS=20000
SESSION_MEMORY_MIN_RECENT_TOKENS=10000
SESSION_MEMORY_MAX_RECENT_TOKENS=40000
# Compatibility name: enables automatic context rollover.
AUTO_COMPACT=true
AUTO_RESUME=safe

# Teambition Open Platform (not required for Agent Kernel tests)
TB_ACCESS_TOKEN=replace-me
TB_TENANT_ID=replace-me
TB_OPERATOR_ID=replace-me
TB_PROJECT_ID=replace-me
